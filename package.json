{
  "name": "pos-control-multiplatform",
  "version": "1.1.0",
  "description": "Punto de venta con servidor local, ventas transaccionales y clientes web.",
  "author": "POS Control",
  "main": "electron-main.js",
  "scripts": {
    "start": "node server/server.js",
    "start:electron": "electron .",
    "dist": "electron-builder",
    "build:win": "electron-builder --win portable",
    "build:all": "electron-builder --win --mac --linux",
    "android:add": "npm run prepare:web && cap add android",
    "android:sync": "npm run prepare:web && cap sync android",
    "android:open": "npx cap open android",
    "setup:server": "npm ci --prefix server",
    "test": "npm test --prefix server",
    "prepare:web": "node scripts/prepare-web.cjs",
    "predist": "npm run prepare:desktop",
    "prebuild:win": "npm run prepare:desktop",
    "prebuild:all": "npm run prepare:desktop",
    "prepare:desktop": "node scripts/prepare-desktop.cjs",
    "backup": "node scripts/data-backup.cjs backup",
    "restore": "node scripts/data-backup.cjs restore"
  },
  "devDependencies": {
    "@capacitor/android": "8.4.3",
    "@capacitor/cli": "8.4.3",
    "electron": "44.5.1",
    "electron-builder": "26.15.3"
  },
  "dependencies": {
    "@capacitor/core": "8.4.3"
  },
  "build": {
    "appId": "com.poscontrol.app",
    "productName": "POS Control",
    "directories": {
      "app": "."
    },
    "files": [
      "electron-main.js",
      "package.json"
    ],
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "signAndEditExecutable": false,
      "artifactName": "POS-Control-${version}-portable.exe"
    },
    "mac": {
      "target": [
        "dmg",
        "zip"
      ]
    },
    "linux": {
      "target": [
        "AppImage",
        "deb",
        "tar.gz"
      ]
    },
    "extraResources": [
      {
        "from": "server",
        "to": "server",
        "filter": [
          "**/*",
          "!test/**",
          "!*.db*",
          "!*.key",
          "!*.lock",
          "!invoices/**"
        ]
      },
      {
        "from": ".",
        "to": ".",
        "filter": [
          "index.html",
          "style.css",
          "app.js",
          "app_utils.js",
          "app_exec_pin.js",
          "display.js",
          "customer-display.html",
          "kitchen-display.html",
          "manifest.webmanifest",
          "icon.svg",
          "pos-math.js",
          "enhancements.js"
        ]
      }
    ]
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "overrides": {
    "app-builder-lib": {
      "@electron/get": "5.1.0"
    }
  }
}
